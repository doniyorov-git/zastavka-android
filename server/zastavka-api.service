[Unit]
Description=Zastavka API
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/zastavka-api
Environment=PORT=3050
Environment=ADMIN_PASSWORD=ZastavkaAdmin!
ExecStart=/usr/bin/node /home/opc/zastavka-api/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

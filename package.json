{
  "name": "zastavka",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server start",
    "dev:admin": "npm --prefix admin run dev",
    "build": "vite build",
    "build:admin": "npm --prefix admin run build",
    "build:android": "VITE_MOBILE=1 VITE_API_BASE=https://silkrood.uz/zastavka-api vite build && npx cap sync android",
    "build:ios": "VITE_MOBILE=1 VITE_API_BASE=https://silkrood.uz/zastavka-api vite build && npx cap sync ios",
    "android:sync": "npx cap sync android",
    "android:icons": "node scripts/android-assets.mjs",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  }
}
